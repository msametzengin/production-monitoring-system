// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MeasurementUnit {
  TON
  KILOGRAM
  CUBIC_METER
  UNIT
}

enum RecordSource {
  MANUAL
  EXCEL_IMPORT
}

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum DowntimeType {
  PLANNED
  UNPLANNED
}

enum DowntimeCategory {
  MAINTENANCE
  BREAKDOWN
  ENERGY
  RAW_MATERIAL
  PERSONNEL
  CLEANING
  PROCESS
  OTHER
}

model Facility {
  id                  Int             @id @default(autoincrement())
  code                String          @unique @db.VarChar(20)
  name                String          @db.VarChar(100)
  location            String?         @db.VarChar(150)
  description         String?         @db.Text
  dailyCapacity       Decimal?        @db.Decimal(12, 2)
  capacityUnit        MeasurementUnit @default(TON)
  plannedDailyMinutes Int             @default(1440)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  products        FacilityProduct[]
  downtimeRecords DowntimeRecord[]

  @@index([isActive])
  @@map("facilities")
}

model Product {
  id              Int             @id @default(autoincrement())
  code            String          @unique @db.VarChar(30)
  name            String          @db.VarChar(120)
  category        String?         @db.VarChar(100)
  description     String?         @db.Text
  measurementUnit MeasurementUnit @default(TON)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  facilities FacilityProduct[]

  @@index([isActive])
  @@index([category])
  @@map("products")
}

model FacilityProduct {
  id                   Int      @id @default(autoincrement())
  facilityId           Int
  productId            Int
  nominalDailyCapacity Decimal? @db.Decimal(12, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  productionRecords ProductionRecord[]
  productionTargets ProductionTarget[]

  @@unique([facilityId, productId])
  @@index([productId])
  @@index([isActive])
  @@map("facility_products")
}

model Shift {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(20)
  name           String   @db.VarChar(80)
  startMinute    Int
  endMinute      Int
  plannedMinutes Int
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productionRecords ProductionRecord[]

  @@index([isActive, sortOrder])
  @@map("shifts")
}

model ProductionRecord {
  id                Int          @id @default(autoincrement())
  recordDate        DateTime     @db.Date
  facilityProductId Int
  shiftId           Int
  quantity          Decimal      @db.Decimal(14, 3)
  operatingMinutes  Int
  source            RecordSource @default(MANUAL)
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  facilityProduct FacilityProduct @relation(fields: [facilityProductId], references: [id], onDelete: Restrict)
  shift           Shift           @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([recordDate, facilityProductId, shiftId])
  @@index([facilityProductId, recordDate])
  @@index([shiftId, recordDate])
  @@map("production_records")
}

model ProductionTarget {
  id                Int          @id @default(autoincrement())
  facilityProductId Int
  period            TargetPeriod
  startDate         DateTime     @db.Date
  endDate           DateTime     @db.Date
  targetQuantity    Decimal      @db.Decimal(14, 3)
  notes             String?      @db.Text
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  facilityProduct FacilityProduct @relation(fields: [facilityProductId], references: [id], onDelete: Restrict)

  @@unique([facilityProductId, period, startDate, endDate])
  @@index([facilityProductId, startDate, endDate])
  @@index([isActive, startDate, endDate])
  @@map("production_targets")
}

model DowntimeReason {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(120)
  category    DowntimeCategory
  defaultType DowntimeType
  description String?          @db.Text
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  downtimeRecords DowntimeRecord[]

  @@index([category, isActive])
  @@map("downtime_reasons")
}

model DowntimeRecord {
  id               Int          @id @default(autoincrement())
  facilityId       Int
  downtimeReasonId Int
  type             DowntimeType
  startedAt        DateTime
  endedAt          DateTime
  durationMinutes  Int
  source           RecordSource @default(MANUAL)
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  downtimeReason DowntimeReason @relation(fields: [downtimeReasonId], references: [id], onDelete: Restrict)

  @@index([facilityId, startedAt])
  @@index([downtimeReasonId, startedAt])
  @@index([type, startedAt])
  @@map("downtime_records")
}
